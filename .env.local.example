# Copy to .env.local and fill in.

# The organization to scan.
GITHUB_ORG=my-org

# --- Credentials: pick ONE mode ---

# Mode A (recommended): GitHub App installed in the org.
# Higher rate limits (15k req/h) and a stable org-scoped identity.
# GITHUB_APP_ID=123456
# Paste the whole PEM: a quoted multi-line value, or one line with \n escapes.
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# Installation id: visible in the URL of the app's org install settings
# (.../installations/<ID>), or via GET /orgs/{org}/installation.
# GITHUB_APP_INSTALLATION_ID=98765432

# Mode B (quick start): personal access token.
# Needs repo + read:org; add admin:org to see org rulesets, apps, PATs and webhooks.
# Get one fast with: gh auth token
GITHUB_TOKEN=ghp_xxx

# --- Optional ---

# Used ONLY for endpoints that reject GitHub App installation tokens:
# the org audit log (Enterprise Cloud) and billing.
# Scopes: admin:org, read:org, and manage_billing:* for costs.
# GITHUB_FALLBACK_PAT=ghp_xxx
